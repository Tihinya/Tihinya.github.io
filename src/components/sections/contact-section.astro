---
import H1 from "../h1.astro";
import ExternalLink from "../external-link.astro";
import { t } from "../../i18n/utils";
import type { Locale } from "../../i18n/utils";

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col justify-between overflow-y-auto">
	<div>
		<H1>{t(locale, 'contact.title')}</H1>
		<p class="mt-4 md:mt-8 lg:mt-12 text-xl xl:text-2xl text-zinc-400 text-balance whitespace-pre-line">
			{t(locale, 'contact.subtitle')}
		</p>

		<div class="mt-6 sm:mt-12 flex flex-col gap-1">
			<a href="mailto:tikhinya.stepan@gmail.com" class="mb-8 w-fit group flex items-center gap-1 text-base lg:text-xl text-zinc-400 hover:text-zinc-50">
				tikhinya.stepan@gmail.com
				<svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="24" height="24" viewBox="0 0 24 24">
					<title>Arrow Icon</title>
					<path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5"/>
					<path fill="currentColor" d="M13.53 8.47a.75.75 0 1 0-1.06 1.06l1.72 1.72H8a.75.75 0 0 0 0 1.5h6.19l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3a.75.75 0 0 0 0-1.06z"/>
				</svg>
			</a>
			<a href="tel:+37255630884" class="mb-8 w-fit group flex items-center gap-1 text-base lg:text-xl text-zinc-400 hover:text-zinc-50">
				+372 55630884
				<svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="24" height="24" viewBox="0 0 24 24">
					<title>Arrow Icon</title>
					<path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5"/>
					<path fill="currentColor" d="M13.53 8.47a.75.75 0 1 0-1.06 1.06l1.72 1.72H8a.75.75 0 0 0 0 1.5h6.19l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3a.75.75 0 0 0 0-1.06z"/>
				</svg>
			</a>

			<ExternalLink href="https://www.linkedin.com/in/stepan-tikhinya/">LinkedIn</ExternalLink>
			<ExternalLink href="https://github.com/Tihinya">GitHub</ExternalLink>
		</div>
	</div>

	<div>
		<p class="text-base text-zinc-500">{t(locale, 'contact.location.city')}</p>
		<p class="text-base text-zinc-500">{t(locale, 'contact.location.country')}</p>
	</div>
</div>
