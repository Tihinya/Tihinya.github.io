---
import H1 from "../h1.astro";
import Link from "../link.astro";
import WarpBackground from "../warp-background";
import AvailableForWork from "../available.astro";
import { t, getLocalizedPath } from "../../i18n/utils";
import type { Locale } from "../../i18n/utils";

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<div class="group relative w-full min-h-dvh flex items-center justify-center">
	<div class="absolute w-full h-dvh -z-10">
		<WarpBackground
			color1="#09090b"
			color2="#27272a"
			color3="#52525b"
			speed={0.6}
			swirl={0.5}
			swirlIterations={10}
			shapeScale={0.3}
			client:load
		/>
	</div>

	<div class="p-4 sm:p-8 absolute w-full h-dvh flex flex-col justify-between z-10">
		<div>
			<H1 size="large"> Stepan <br /> Tikhinya </H1>
		</div>

		<div>
			<AvailableForWork className="py-4" label={t(locale, 'home.availableForWork')} />
			<div class="mb-2 sm:mb-4 flex items-center gap-4">
				<Link href={getLocalizedPath('/projects', locale)}>{t(locale, 'home.viewWork')}</Link>
				<Link href={getLocalizedPath('/contact', locale)} variant="secondary">{t(locale, 'home.bookCall')}</Link>
			</div>
		</div>
	</div>
</div>
